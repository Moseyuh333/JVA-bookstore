<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
	version="3.1">
	<display-name>JVA Bookstore</display-name>
	<filter>
		<filter-name>sitemesh</filter-name>
		<filter-class>com.opensymphony.sitemesh.webapp.SiteMeshFilter</filter-class>
		<init-param>
			<param-name>config</param-name>
			<param-value>/WEB-INF/sitemesh.xml</param-value>
		</init-param>
	</filter>
	<filter-mapping>
		<filter-name>sitemesh</filter-name>
		<url-pattern>/*</url-pattern>
	</filter-mapping>

	<welcome-file-list>
		<welcome-file>index.jsp</welcome-file>
	</welcome-file-list>

	<error-page>
		<exception-type>java.lang.Throwable</exception-type>
		<location>/error.jsp</location>
	</error-page>

	<!-- Servlet mappings handled by @WebServlet annotations -->

	<servlet>
		<servlet-name>ResetServlet</servlet-name>
		<servlet-class>web.ResetServlet</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>ResetServlet</servlet-name>
		<url-pattern>/api/auth/reset</url-pattern>
	</servlet-mapping>

	<servlet>
		<servlet-name>BooksApiServlet</servlet-name>
		<servlet-class>web.BooksApiServlet</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>BooksApiServlet</servlet-name>
		<url-pattern>/api/books</url-pattern>
	</servlet-mapping>

	<servlet>
		<servlet-name>HealthServlet</servlet-name>
		<servlet-class>web.HealthServlet</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>HealthServlet</servlet-name>
		<url-pattern>/api/health</url-pattern>
	</servlet-mapping>
	<servlet>
		<servlet-name>BookDetailServlet</servlet-name>
		<servlet-class>web.BookDetailServlet</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>BookDetailServlet</servlet-name>
		<url-pattern>/books/detail</url-pattern>
	</servlet-mapping>

	<servlet>
		<servlet-name>ReviewServlet</servlet-name>
		<servlet-class>web.ReviewServlet</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>ReviewServlet</servlet-name>
		<url-pattern>/books/review</url-pattern>
	</servlet-mapping>

</web-app>
